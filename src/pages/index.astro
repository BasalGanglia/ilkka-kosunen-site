---
import BaseLayout from '../layouts/BaseLayout.astro';
import MermaidBlueprint from '../components/MermaidBlueprint.astro';
import profile from '../data/profile.json';
import { blueprints } from '../data/blueprints';
const emailLink = `mailto:${profile.email}?subject=Architecture%20consulting%20inquiry`;
---
<BaseLayout>
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
      <a href="/" class="font-semibold">{profile.name}</a>
      <nav aria-label="Main navigation" class="flex flex-wrap gap-5 text-sm">
        <a href="#work">Architecture</a><a href="#services">Consulting</a><a href="#about">About</a><a href="#contact">Contact</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="max-w-3xl text-sm text-blue-800">{profile.availability}</p>
      <p class="mt-8 text-sm font-medium uppercase tracking-widest text-slate-600">{profile.role}</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl leading-tight tracking-tight sm:text-7xl">{profile.headline}</h1>
      <p class="mt-7 max-w-2xl text-xl leading-relaxed text-slate-600">{profile.intro}</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href={emailLink} class="rounded-lg bg-slate-900 px-6 py-3 font-medium text-white hover:bg-blue-800">Discuss your project →</a>
        <a href="#work" class="rounded-lg border border-slate-300 px-6 py-3 font-medium">Explore the architecture</a>
        {profile.cvPath && <a href={profile.cvPath} class="rounded-lg border border-slate-300 px-6 py-3">Download CV</a>}
      </div>
      <p class="mt-8 text-sm text-slate-500">{profile.location}</p>
    </section>
    <section id="services" class="border-y border-slate-200 bg-white py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-serif text-4xl">Practical help, clearly scoped.</h2>
        <p class="mt-4 max-w-2xl text-slate-600">Start with the problem, not a prescribed stack. Engagement scope, availability, pricing and acceptance criteria are agreed before work begins.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {profile.services.map((service) => <article class="rounded-xl border border-slate-200 p-6"><h3 class="text-xl font-semibold">{service.title}</h3><p class="mt-4 leading-relaxed text-slate-600">{service.description}</p></article>)}
        </div>
      </div>
    </section>
    <section id="work" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-serif text-4xl">Architecture you can inspect.</h2>
      <p class="mt-4 max-w-3xl text-slate-600">Illustrative reference architectures, not claims about a specific client deployment. These patterns make trade-offs, validation boundaries and human oversight explicit.</p>
      <div class="mt-10 space-y-10">
        {blueprints.map((blueprint) => <article><h3 class="text-2xl font-semibold">{blueprint.title}</h3><p class="mt-3 mb-5 max-w-3xl leading-relaxed text-slate-600">{blueprint.summary}</p><MermaidBlueprint {...blueprint} /></article>)}
      </div>
    </section>
    <section id="about" class="border-y border-slate-200 bg-white py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-serif text-4xl">Research depth. Systems perspective.</h2>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">I am a computer scientist and software architect working across AI-assisted engineering, document intelligence and knowledge systems. My focus is the boundary between probabilistic models and explicit engineering contracts: data models, tests, provenance and operational controls.</p>
        <p class="mt-5 max-w-3xl leading-relaxed text-slate-600">Areas of interest include Python backends, RDF/OWL/SHACL, knowledge graphs, retrieval, agent tools and cloud-native delivery. I am planning a transition from Cadentia Technologies Oy to my independent consulting practice.</p>
      </div>
    </section>
  </main>
  <footer id="contact" class="bg-slate-950 py-16 text-white">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-serif text-4xl">Bring a difficult systems problem.</h2>
      <p class="mt-4 max-w-2xl text-slate-300">Tell me what you are building, where it is getting stuck and what a useful outcome would look like.</p>
      <a href={emailLink} class="mt-7 inline-block rounded-lg bg-blue-600 px-6 py-3 font-medium">{profile.email}</a>
      <div class="mt-10 flex flex-wrap gap-6 text-sm text-slate-300"><span>© {new Date().getFullYear()} {profile.name}</span><a href={profile.github}>GitHub</a><span>{profile.location}</span></div>
      {profile.businessName && <p class="mt-4 text-sm text-slate-300">{profile.businessName}{profile.businessId ? ` · Business ID: ${profile.businessId}` : ''}</p>}
    </div>
  </footer>
</BaseLayout>
